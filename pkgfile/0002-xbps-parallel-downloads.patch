+static void *
+fetch_worker(void *arg)
+{
+	struct fetch_pool *pool = arg;
+	struct binpkg_fetch *bf;
+
+	for (;;) {
+		pthread_mutex_lock(&pool->mtx);
+		if (pool->failed || pool->next >= pool->njobs) {
+			pthread_mutex_unlock(&pool->mtx);
+			break;
+		}
+		bf = &pool->jobs[pool->next++];
+		pthread_mutex_unlock(&pool->mtx);
