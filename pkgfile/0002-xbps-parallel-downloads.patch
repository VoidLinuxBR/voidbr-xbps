 #include <assert.h>
+#include <unistd.h>
 #include <xbps.h>
 #include "defs.h"
 
+/*
+ * pacman-style integrity check display: one line, redrawn in place,
+ *   (37/120) checking package integrity       [#######----------]  30%
+ * instead of one "pkg: verifying ..." line per package. Only on a
+ * terminal and without -d; otherwise the per-package lines are kept,
+ * since they are what a log needs.
+ */
+static struct {
+	unsigned int total;
+	unsigned int done;
+	bool active;	/* counting packages for the current transaction */
+	bool open;	/* a line is on screen without its final newline */
+} vfy;
+
+static unsigned int
+count_verify_pkgs(struct xbps_handle *xhp)
+{
+	xbps_array_t pkgs;
+	unsigned int i, n = 0;
+
+	if (xhp->transd == NULL)
+		return 0;
+	pkgs = xbps_dictionary_get(xhp->transd, "packages");
+	for (i = 0; i < xbps_array_count(pkgs); i++) {
+		xbps_trans_type_t ttype;
+
+		ttype = xbps_transaction_pkg_type(xbps_array_get(pkgs, i));
+		if (ttype == XBPS_TRANS_REMOVE || ttype == XBPS_TRANS_HOLD ||
+		    ttype == XBPS_TRANS_CONFIGURE)
+			continue;
+		n++;
+	}
+	return n;
+}
+
+static void
+verify_line_close(void)
+{
+	if (vfy.open) {
+		printf("\n");
+		fflush(stdout);
+	}
+	vfy.open = false;
+}
+
+static void
+verify_line_draw(void)
+{
+	char left[64], bar[128];
+	int cols, barw, leftw, pct, fill, i;
+	unsigned int total = vfy.total > vfy.done ? vfy.total : vfy.done;
+
+	cols = get_maxcols();
+	if (cols <= 0)
+		cols = 80;
+	pct = total ? (int)(vfy.done * 100 / total) : 100;
+	snprintf(left, sizeof left, "(%u/%u) checking package integrity",
+	    vfy.done, total);
+
+	/* "left" + " [" + bar + "] " + "100%", one column spare */
+	barw = cols - (int)strlen(left) - 1 - 2 - 2 - 4 - 1;
+	if (barw > (int)sizeof(bar) - 1)
+		barw = (int)sizeof(bar) - 1;
+	if (barw < 10)
+		barw = 10;
+	leftw = cols - barw - 2 - 2 - 4 - 1;
+	if (leftw < (int)strlen(left))
+		leftw = (int)strlen(left);
+
+	fill = barw * pct / 100;
+	for (i = 0; i < barw; i++)
+		bar[i] = i < fill ? '#' : '-';
+	bar[barw] = '\0';
+
+	printf("\r%-*s [%s] %3d%%\033[K", leftw, left, bar, pct);
+	fflush(stdout);
+	vfy.open = true;
+	if (vfy.done >= total)
+		verify_line_close();
+}
