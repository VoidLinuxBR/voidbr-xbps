+/*
+ * Parallel downloads.
+ *
+ * Workers pull the next pending package off a shared index and only
+ * download it (signature + package + sha256 digest computed while
+ * streaming). Failure reports and signature checks, which touch
+ * shared libxbps state, run afterwards on the calling thread, in
+ * transaction order.
+ *
+ * On the first failure no new downloads are started; transfers
+ * already in flight are left to finish (their .part files would be
+ * resumed by the next run anyway).
+ */
+struct fetch_pool {
+	struct xbps_handle *xhp;
+	struct binpkg_fetch *jobs;
+	unsigned int njobs;
+	unsigned int next;
+	bool failed;
+	pthread_mutex_t mtx;
+};
