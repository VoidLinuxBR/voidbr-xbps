+/*
+ * pacman-style phase lines: one line per phase, redrawn in place,
+ *   (37/120) Verifying package integrity      [■■■■■■⠹□□□□□□□□□□]  30%
+ *   (37/120) Collecting package files         [■■■■■■⠹□□□□□□□□□□]  30%
+ * instead of one "pkg: ..." line per package, with the bars of every
+ * phase lined up. The labels are the same texts xbps has always used
+ * for these phases, so nothing new to learn. Only on a terminal and without -d; otherwise the
+ * per-package lines (and the "[*] ..." headers) are kept, since they
+ * are what a log needs.
+ */
+/*
+ * Every numbered line (phases above, and the per-package lines of the
+ * unpack and configure steps below) has a fixed-width left part, so
+ * their bars line up. Longer labels are cut.
+ */
+#define LINE_LABEL_W	44
+
+static struct {
+	const char *label;
+	unsigned int total;
+	unsigned int done;
+	char last[XBPS_NAME_SIZE];	/* package of the last step */
+	bool active;	/* counting packages for the current phase */
+	bool open;	/* a line is on screen without its final newline */
+} ph;
+
+/* packages that go through the integrity check / file collection */
+static unsigned int
+count_phase_pkgs(struct xbps_handle *xhp, bool with_removes)
+{
+	xbps_array_t pkgs;
+	unsigned int i, n = 0;
+
+	if (xhp->transd == NULL)
+		return 0;
+	pkgs = xbps_dictionary_get(xhp->transd, "packages");
+	for (i = 0; i < xbps_array_count(pkgs); i++) {
+		xbps_trans_type_t ttype;
+
+		ttype = xbps_transaction_pkg_type(xbps_array_get(pkgs, i));
+		if (ttype == XBPS_TRANS_HOLD || ttype == XBPS_TRANS_CONFIGURE)
+			continue;
+		if (ttype == XBPS_TRANS_REMOVE && !with_removes)
+			continue;
+		n++;
+	}
+	return n;
+}
+
+static void
+line_print(unsigned int done, unsigned int total, const char *label,
+    int pct, bool withbar)
+{
+	char left[128], bar[2048];
+	int cols, barw, nw, leftw;
+
+	cols = get_maxcols();
+	if (cols <= 0)
+		cols = 80;
+	if (total < done)
+		total = done;
+	nw = snprintf(NULL, 0, "%u", total);
+	snprintf(left, sizeof left, "(%*u/%u) %.*s", nw, done, total,
+	    LINE_LABEL_W, label);
+	leftw = 2 * nw + 4 + LINE_LABEL_W;
+
+	if (!withbar) {
+		printf("\r%s\033[K", left);
+		fflush(stdout);
+		return;
+	}
+	/* left + " [" + bar + "] " + "100%", one column spare */
+	barw = cols - leftw - 2 - 2 - 4 - 1;
+	if (barw > 120)
+		barw = 120;
+	if (barw < 10)
+		barw = 10;
+	progress_bar(bar, sizeof bar, barw, pct);
+	printf("\r%-*s [%s] %3d%%\033[K", leftw, left, bar, pct);
+	fflush(stdout);
+}
+
+static void
+phase_draw(void)
+{
+	unsigned int total = ph.total > ph.done ? ph.total : ph.done;
+
+	line_print(ph.done, total, ph.label,
+	    total ? (int)(ph.done * 100 / total) : 100, true);
+	ph.open = true;
+}
+
+/*
+ * Unpack and configure steps: one numbered line per package, like
+ * pacman's "(1/6) installing ...", using the texts xbps already shows:
+ *   ( 1/6) Unpacking pt1-1.0_1                [■■■■■■■■■■■■■⠹□□□□□]  70%
+ *   ( 2/6) Updating pt2-1.0_1 -> 1.0_2        [■■■■■■■■■■■■■■■■■■■] 100%
+ *   ( 3/6) Removing pt7-1.0_1
+ *   ( 1/5) Configuring pt1-1.0_1
+ * The unpack bar follows the files extracted (unpack callback). Every
+ * line ends with a newline before the next package, so output of the
+ * packages' INSTALL/REMOVE scripts lands between lines, never inside.
+ * Only on a terminal and without -d or -v.
+ */
+static struct {
+	bool active;		/* per-package lines for this step */
+	bool open;		/* a line with a bar is on screen, no newline */
+	bool bar;
+	bool suspended;		/* closed to let a message through */
+	unsigned int total;
+	unsigned int done;
+	int pct;
+	unsigned int frame;
+	char label[XBPS_NAME_SIZE * 2 + 32];
+	char pkgname[XBPS_NAME_SIZE];
+} pk;
+
+static unsigned int
+count_step_pkgs(struct xbps_handle *xhp, bool configure)
+{
+	xbps_array_t pkgs;
+	unsigned int i, n = 0;
+
+	if (xhp->transd == NULL)
+		return 0;
+	pkgs = xbps_dictionary_get(xhp->transd, "packages");
+	for (i = 0; i < xbps_array_count(pkgs); i++) {
+		xbps_trans_type_t ttype;
+
+		ttype = xbps_transaction_pkg_type(xbps_array_get(pkgs, i));
+		if (ttype == XBPS_TRANS_HOLD)
+			continue;
+		if (configure ? ttype == XBPS_TRANS_REMOVE :
+		    ttype == XBPS_TRANS_CONFIGURE)
+			continue;
+		n++;
+	}
+	return n;
+}
+
+static void
+pk_draw(void)
+{
+	line_print(pk.done, pk.total, pk.label, pk.pct, pk.bar);
+}
+
+static void
+pk_close(bool complete)
+{
+	if (pk.open) {
+		if (complete && pk.bar && pk.pct < 100) {
+			pk.pct = 100;
+			pk_draw();
+		}
+		printf("\n");
+		fflush(stdout);
+	}
+	pk.open = false;
+	pk.suspended = false;
+}
+
+static void
+pk_begin(struct xbps_handle *xhp, bool configure)
+{
+	pk_close(true);
+	memset(&pk, 0, sizeof pk);
+	pk.total = count_step_pkgs(xhp, configure);
+	pk.active = isatty(STDOUT_FILENO) &&
+	    !(xhp->flags & (XBPS_FLAG_DEBUG | XBPS_FLAG_VERBOSE));
+}
+
+static void
+pk_new_line(const char *pkgver, bool withbar, const char *fmt, ...)
+{
+	va_list ap;
+
+	pk_close(true);
+	pk.done++;
+	pk.pct = 0;
+	pk.bar = withbar;
+	va_start(ap, fmt);
+	vsnprintf(pk.label, sizeof pk.label, fmt, ap);
+	va_end(ap);
+	if (pkgver == NULL ||
+	    !xbps_pkg_name(pk.pkgname, sizeof pk.pkgname, pkgver))
+		pk.pkgname[0] = '\0';
+	pk_draw();
+	if (withbar) {
+		pk.open = true;
+	} else {
+		printf("\n");
+		fflush(stdout);
+	}
+}
+
+/* let a message through without losing the package line */
+static void
+pk_suspend(void)
+{
+	if (pk.open) {
+		printf("\n");
+		fflush(stdout);
+		pk.open = false;
+		pk.suspended = true;
+	}
+}
+
+static void
+pk_resume(void)
+{
+	if (pk.suspended) {
+		pk.suspended = false;
+		pk.open = true;
+		pk_draw();
+	}
+}
+
+/* called by the unpack callback for every file extracted */
+void
+state_unpack_progress(const struct xbps_unpack_cb_data *xpd)
+{
+	unsigned int frame;
+	int pct;
+
+	if (!pk.active || !pk.open || !pk.bar || xpd->entry_total_count <= 0)
+		return;
+	pct = (int)(xpd->entry_extract_count * 100 / xpd->entry_total_count);
+	if (pct > 100)
+		pct = 100;
+	frame = progress_frame();
+	/* redraw only when something visible changes */
+	if (pct == pk.pct && frame == pk.frame)
+		return;
+	pk.pct = pct;
+	pk.frame = frame;
+	pk_draw();
+}
+
+/* ends whatever line is still open (e.g. with -U there is no configure step) */
+void
+state_lines_finish(void)
+{
+	pk_close(true);
+	pk.active = false;
+}
+
+static void
+phase_begin(struct xbps_handle *xhp, const char *label, unsigned int total)
+{
+	ph.label = label;
+	ph.total = total;
+	ph.done = 0;
+	ph.last[0] = '\0';
+	ph.open = false;
+	ph.active = isatty(STDOUT_FILENO) && !(xhp->flags & XBPS_FLAG_DEBUG);
+}
+
+/* one more package done (repeated messages for the same one count once) */
+static void
+phase_step(const char *pkgver)
+{
+	char pkgname[XBPS_NAME_SIZE];
+
+	if (pkgver == NULL || !xbps_pkg_name(pkgname, sizeof pkgname, pkgver))
+		pkgname[0] = '\0';
+	if (pkgname[0] == '\0' || strcmp(pkgname, ph.last) != 0) {
+		ph.done++;
+		xbps_strlcpy(ph.last, pkgname, sizeof ph.last);
+	}
+	phase_draw();
+}
+
+/*
+ * Ends the phase line. `complete' is false when a phase is cut short
+ * by an error, so the line stays where it stopped; otherwise it is
+ * drawn at 100% (a package without files to collect sends no message).
+ */
+static void
+phase_end(bool complete)
+{
+	if (ph.active && ph.open && complete && ph.done < ph.total) {
+		ph.done = ph.total;
+		phase_draw();
+	}
+	if (ph.open) {
+		printf("\n");
+		fflush(stdout);
+	}
+	ph.open = false;
+	ph.active = false;
+}
