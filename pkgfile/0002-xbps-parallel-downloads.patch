+/*
+ * VoidBR progress bar, shared by the download and the integrity check
+ * displays:
+ *
+ *   [■■■■■■■■■■■■⠹□□□□□□□]
+ *
+ * Every completed step is a square; the leading cell is a spinner that
+ * keeps turning while there is work going on: the braille dots
+ * ⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏ on a UTF-8 terminal, or | / - \ on the Linux
+ * console (its fonts have no braille) and without UTF-8. Spinner
+ * frames come from a monotonic clock (SPIN_MS each), so every bar on
+ * screen turns in sync; the parallel download display is redrawn at
+ * that same pace by its own thread, so no frame is skipped. At 100%
+ * the spinner is gone and the bar is all squares.
+ *
+ * Colors: squares in green, spinner in yellow, the rest in gray;
+ * disabled by NO_COLOR (https://no-color.org) or TERM=dumb.
+ * Without a UTF-8 locale the squares become "#" and "-".
+ */
+#define SPIN_MS	100
+
+static const char *green = "\033[32m";
+static const char *yellow = "\033[33m";
+static const char *gray = "\033[90m";
+static const char *reset = "\033[0m";
+
+static bool
+locale_is_utf8(void)
+{
+	const char *vars[] = { "LC_ALL", "LC_CTYPE", "LANG" };
+	const char *v;
+
+	for (size_t i = 0; i < sizeof(vars) / sizeof(vars[0]); i++) {
+		v = getenv(vars[i]);
+		if (v == NULL || *v == '\0')
+			continue;
+		/* the first one set wins, like setlocale(3) */
+		return strcasestr(v, "utf-8") != NULL ||
+		    strcasestr(v, "utf8") != NULL;
+	}
+	return false;
+}
+
+static bool
+use_colors(void)
+{
+	const char *nc = getenv("NO_COLOR"), *term = getenv("TERM");
+
+	if (nc != NULL && *nc != '\0')
+		return false;
+	return term == NULL || strcmp(term, "dumb") != 0;
+}
+
+static unsigned int
+bar_frame(void)
+{
+	struct timeval tv;
+
+	get_time(&tv);
+	return (unsigned int)((tv.tv_sec * 1000 + tv.tv_usec / 1000) / SPIN_MS);
+}
+
+unsigned int
+progress_frame(void)
+{
+	return bar_frame();
+}
+
+void
+progress_bar(char *buf, size_t len, int width, int pct)
+{
+	static const char *braille[] = {
+		"⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"
+	};
+	static const char *ascii[] = { "|", "/", "-", "\\" };
+	static int utf8 = -1, color = -1, dots = -1;
+	const char *cur = NULL, *c, *glyph, *tip;
+	size_t off = 0;
+	int fill, i;
+	bool done;
+
+#define BAR_PUT(s) do { \
+		size_t l_ = strlen(s); \
+		if (off + l_ < len) { memcpy(buf + off, s, l_); off += l_; } \
+	} while (0)
+
+	if (utf8 == -1) {
+		const char *term = getenv("TERM");
+
+		utf8 = locale_is_utf8();
+		color = use_colors();
+		/* the Linux console fonts have no braille glyphs */
+		dots = utf8 && !(term && strcmp(term, "linux") == 0);
+	}
+	if (len == 0)
+		return;
+	if (pct < 0)
+		pct = 0;
+	if (pct > 100)
+		pct = 100;
+	fill = width * pct / 100;
+	done = fill >= width;
+	tip = dots ? braille[bar_frame() % 10] : ascii[bar_frame() % 4];
+
+	for (i = 0; i < width; i++) {
+		if (i < fill) {
+			/* completed step */
+			glyph = utf8 ? "■" : "#";
+			c = green;
+		} else if (i == fill && !done) {
+			/* working: spinner at the leading cell */
+			glyph = tip;
+			c = yellow;
+		} else {
+			glyph = utf8 ? "□" : "-";
+			c = gray;
+		}
+		if (color && c != cur) {
+			BAR_PUT(c);
+			cur = c;
+		}
+		BAR_PUT(glyph);
+	}
+	if (color)
+		BAR_PUT(reset);
+	buf[off] = '\0';
+#undef BAR_PUT
+}
+
+/*
+ * Parallel downloads (see lib/transaction_fetch.c): pacman-style
+ * display with one line per transfer in flight plus a "Total" line,
+ * redrawn in place when stderr is a terminal. libxbps serializes
+ * every callback, so no locking is needed here.
+ */
+struct pslot {
+	char *file;
+	char label[256];
+	off_t size;
+	off_t offset;
+	off_t dloaded;
+	struct timeval start;
+	bool finished;
+};
+
+static struct {
+	struct pslot *slots;
+	size_t nslots;
+	unsigned int drawn;
+	unsigned int done_pkgs;
+	uint64_t done_bytes;
+	struct timeval start;
+	struct timeval lastdraw;
+	struct xbps_handle *xhp;
+	pthread_t thr;		/* redraws the display every SPIN_MS */
+	bool thr_running;
+	bool thr_stop;
+	bool open;
+	bool fancy;
+} par;
+
+/*
+ * Guards `par': taken by the download callbacks (which libxbps already
+ * serializes among themselves) and by the redraw thread. Lock order is
+ * always libxbps callback lock -> par_mtx; the redraw thread only ever
+ * takes par_mtx.
+ */
+static pthread_mutex_t par_mtx = PTHREAD_MUTEX_INITIALIZER;
+
+static double
+tv_secs(const struct timeval *tv)
+{
+	return (double)tv->tv_sec + (double)tv->tv_usec / 1.e6;
+}
+
+/*
+ * Same condition libxbps uses to download in parallel: more than one
+ * package to fetch in a transaction and paralleldownloads > 1.
+ * Anything else (repository sync, xbps-fetch, a single package) keeps
+ * the classic one-file-at-a-time display.
+ */
+static bool
+is_parallel(const struct xbps_fetch_cb_data *xfpd)
+{
+	uint32_t n = 0;
+
+	if (xfpd->xhp == NULL || xfpd->xhp->paralleldownloads < 2 ||
+	    xfpd->xhp->transd == NULL)
+		return false;
+	return xbps_dictionary_get_uint32(xfpd->xhp->transd,
+	    "total-download-pkgs", &n) && n > 1;
+}
+
+static bool
+ends_with(const char *s, const char *suffix)
+{
+	size_t ls = strlen(s), lx = strlen(suffix);
+
+	return ls >= lx && strcmp(s + ls - lx, suffix) == 0;
+}
+
+/* "foo-1.2_1.x86_64.xbps" -> "foo-1.2_1" */
+static void
+make_label(char *dst, size_t dstlen, const char *file)
+{
+	const char *base = strrchr(file, '/');
+	char *dot;
+
+	xbps_strlcpy(dst, base ? base + 1 : file, dstlen);
+	if (ends_with(dst, ".xbps")) {
+		dst[strlen(dst) - 5] = '\0';
+		if ((dot = strrchr(dst, '.')) != NULL)
+			*dot = '\0';
+	}
+}
+
+static void
+fmt_time(char *buf, size_t len, double secs)
+{
+	long t = (long)secs;
+
+	if (secs < 0 || t > 5999)
+		snprintf(buf, len, "--:--");
+	else
+		snprintf(buf, len, "%02u:%02u", (unsigned)(t / 60) % 100u,
+		    (unsigned)(t % 60));
+}
+
+static int
+term_cols(void)
+{
+	struct winsize ws;
+
+	if (ioctl(STDERR_FILENO, TIOCGWINSZ, &ws) == 0 && ws.ws_col > 0)
+		return ws.ws_col;
+	return 80;
+}
+
+/*
+ * One pacman-like line:
+ *  label                        12MB  1024KB/s 00:05 [######--------]  45%
+ */
+static void
+par_print_line(const char *label, off_t total, off_t done, double bps,
+		double secs, int cols)
+{
+	char sz[8], rate[16], tm[8], bar[512];
+	int barw = 20, namew, pct;
+
+	if (total > 0) {
+		pct = (int)((double)done * 100.0 / (double)total);
+		if (pct > 100)
+			pct = 100;
+		(void)xbps_humanize_number(sz, (int64_t)total);
+	} else {
+		pct = 0;
+		snprintf(sz, sizeof sz, "?");
+	}
+	if (bps > 0) {
+		char h[8];
+		(void)xbps_humanize_number(h, (int64_t)bps);
+		snprintf(rate, sizeof rate, "%s/s", h);
+	} else {
+		snprintf(rate, sizeof rate, "--");
+	}
+	fmt_time(tm, sizeof tm, secs);
+
+	/* " " + name + " " + right part (7+1+10+1+5+1+[bar]+1+4) */
+	namew = cols - 1 - (32 + barw) - 1;
+	if (namew < 16) {
+		barw = 10;
+		namew = cols - 1 - (32 + barw) - 1;
+	}
+	if (namew < 8)
+		namew = 8;
+
+	progress_bar(bar, sizeof bar, barw, pct);
+
+	fprintf(stderr, " %-*.*s %7s %10s %5s [%s] %3d%%\033[K\n",
+	    namew, namew, label, sz, rate, tm, bar, pct);
+}
+
+static void
+par_redraw(struct xbps_handle *xhp, bool force, bool final)
+{
+	struct timeval now;
+	uint64_t total_size = 0, done;
+	uint32_t total_pkgs = 0;
+	double elapsed, bps, eta;
+	char label[64];
+	size_t i, j;
+	int cols;
+
+	get_time(&now);
+	if (!force && tv_secs(&now) - tv_secs(&par.lastdraw) < 0.2)
+		return;
+	par.lastdraw = now;
+	cols = term_cols();
+
+	if (par.drawn > 0)
+		fprintf(stderr, "\033[%uA", par.drawn);
+
+	/* finished transfers scroll up and stay on screen */
+	for (i = j = 0; i < par.nslots; i++) {
+		struct pslot *sl = &par.slots[i];
+
+		if (sl->finished) {
+			elapsed = tv_secs(&now) - tv_secs(&sl->start);
+			bps = elapsed > 0 ? (double)(sl->dloaded - sl->offset) / elapsed : 0;
+			par_print_line(sl->label, sl->size, sl->size, bps, elapsed, cols);
+			free(sl->file);
+			continue;
+		}
+		par.slots[j++] = *sl;
+	}
+	par.nslots = j;
+
+	/* transfers in flight */
+	for (i = 0; i < par.nslots; i++) {
+		struct pslot *sl = &par.slots[i];
+
+		elapsed = tv_secs(&now) - tv_secs(&sl->start);
+		bps = elapsed > 0 ? (double)(sl->dloaded - sl->offset) / elapsed : 0;
+		eta = (bps > 0 && sl->size > 0) ?
+		    (double)(sl->size - sl->dloaded) / bps : -1;
+		par_print_line(sl->label, sl->size, sl->dloaded, bps, eta, cols);
+	}
+
+	/* total */
+	if (xhp != NULL && xhp->transd != NULL) {
+		xbps_dictionary_get_uint64(xhp->transd,
+		    "total-download-size", &total_size);
+		xbps_dictionary_get_uint32(xhp->transd,
+		    "total-download-pkgs", &total_pkgs);
+	}
+	done = par.done_bytes;
+	for (i = 0; i < par.nslots; i++)
+		done += (uint64_t)par.slots[i].dloaded;
+	if (total_size > 0 && done > total_size)
+		done = total_size;
+	elapsed = tv_secs(&now) - tv_secs(&par.start);
+	bps = elapsed > 0 ? (double)done / elapsed : 0;
+	if (final)
+		eta = elapsed;
+	else
+		eta = (bps > 0 && total_size > done) ?
+		    (double)(total_size - done) / bps : -1;
+	snprintf(label, sizeof label, "Total (%u/%u)", par.done_pkgs,
+	    total_pkgs ? total_pkgs : par.done_pkgs);
+	par_print_line(label, (off_t)total_size, (off_t)(final ? total_size : done),
+	    bps, eta, cols);
+
+	fprintf(stderr, "\033[J");
+	fflush(stderr);
+	par.drawn = final ? 0 : (unsigned int)par.nslots + 1;
+}
+
+static struct pslot *
+par_find(const char *file)
+{
+	for (size_t i = 0; i < par.nslots; i++)
+		if (!par.slots[i].finished && strcmp(par.slots[i].file, file) == 0)
+			return &par.slots[i];
+	return NULL;
+}
+
+static void
+par_reset(void)
+{
+	for (size_t i = 0; i < par.nslots; i++)
+		free(par.slots[i].file);
+	free(par.slots);
+	memset(&par, 0, sizeof par);
+}
+
+static void *
+par_redraw_thread(void *arg UNUSED)
+{
+	struct timespec ts = { 0, SPIN_MS * 1000000L };
+
+	for (;;) {
+		pthread_mutex_lock(&par_mtx);
+		if (par.thr_stop) {
+			pthread_mutex_unlock(&par_mtx);
+			break;
+		}
+		if (par.nslots > 0 || par.drawn > 0)
+			par_redraw(par.xhp, true, false);
+		pthread_mutex_unlock(&par_mtx);
+		nanosleep(&ts, NULL);
+	}
+	return NULL;
+}
+
+/* call WITHOUT par_mtx held */
+static void
+par_stop_thread(void)
+{
+	pthread_t thr;
+
+	pthread_mutex_lock(&par_mtx);
+	if (!par.thr_running) {
+		pthread_mutex_unlock(&par_mtx);
+		return;
+	}
+	par.thr_stop = true;
+	thr = par.thr;
+	pthread_mutex_unlock(&par_mtx);
+
+	pthread_join(thr, NULL);
+
+	pthread_mutex_lock(&par_mtx);
+	par.thr_running = false;
+	par.thr_stop = false;
+	pthread_mutex_unlock(&par_mtx);
+}
+
+/*
+ * Updates the display state; returns true when the last package just
+ * finished and the display has to be closed (done by the caller, with
+ * par_mtx released, since that stops the redraw thread).
+ */
+static bool
+par_progress_locked(const struct xbps_fetch_cb_data *xfpd)
+{
+	struct pslot *sl, *n;
+	uint32_t total_pkgs = 0;
+
+	/* signatures are tiny, keep the display about the packages */
+	if (ends_with(xfpd->file_name, ".sig2") ||
+	    ends_with(xfpd->file_name, ".sig"))
+		return false;
+
+	if (!par.open) {
+		par.open = true;
+		par.xhp = xfpd->xhp;
+		par.fancy = isatty(STDERR_FILENO) &&
+		    !(xfpd->xhp->flags & XBPS_FLAG_DEBUG);
+		get_time(&par.start);
+		if (par.fancy && pthread_create(&par.thr, NULL,
+		    par_redraw_thread, NULL) == 0)
+			par.thr_running = true;
+	}
+
+	if (xfpd->cb_start) {
+		n = realloc(par.slots, (par.nslots + 1) * sizeof(*n));
+		if (n == NULL)
+			return false;
+		par.slots = n;
+		sl = &par.slots[par.nslots];
+		memset(sl, 0, sizeof(*sl));
+		if ((sl->file = strdup(xfpd->file_name)) == NULL)
+			return false;
+		par.nslots++;
+		make_label(sl->label, sizeof sl->label, xfpd->file_name);
+		sl->size = xfpd->file_size;
+		sl->offset = xfpd->file_offset;
+		sl->dloaded = xfpd->file_dloaded;
+		get_time(&sl->start);
+		if (par.fancy && !par.thr_running)
+			par_redraw(par.xhp, true, false);
+		return false;
+	}
+
+	if ((sl = par_find(xfpd->file_name)) == NULL)
+		return false;
+
+	if (xfpd->cb_update) {
+		sl->dloaded = xfpd->file_dloaded;
+		if (par.fancy && !par.thr_running)
+			par_redraw(par.xhp, false, false);
+		return false;
+	}
+
+	/* cb_end */
+	if (sl->size > 0)
+		sl->dloaded = sl->size;
+	sl->finished = true;
+	par.done_pkgs++;
+	par.done_bytes += (uint64_t)(sl->size > 0 ? sl->size : sl->dloaded);
+
+	if (xfpd->xhp->transd != NULL)
+		xbps_dictionary_get_uint32(xfpd->xhp->transd,
+		    "total-download-pkgs", &total_pkgs);
+
+	if (par.fancy) {
+		bool last = total_pkgs > 0 && par.done_pkgs >= total_pkgs;
+
+		if (last)
+			return true;
+		if (!par.thr_running)
+			par_redraw(par.xhp, true, false);
+	} else {
+		struct timeval now;
+		char size[8], rate[16];
+		double elapsed;
+
+		get_time(&now);
+		elapsed = tv_secs(&now) - tv_secs(&sl->start);
+		(void)xbps_humanize_number(size, (int64_t)sl->dloaded);
+		if (elapsed > 0) {
+			char h[8];
+			(void)xbps_humanize_number(h,
+			    (int64_t)((double)(sl->dloaded - sl->offset) / elapsed));
+			snprintf(rate, sizeof rate, "%s/s", h);
+		} else {
+			snprintf(rate, sizeof rate, "--");
+		}
+		printf("%s: %s [avg rate: %s]\n", sl->label, size, rate);
+		fflush(stdout);
+		free(sl->file);
+		*sl = par.slots[--par.nslots];
+		if (total_pkgs > 0 && par.done_pkgs >= total_pkgs)
+			par_reset();
+	}
+	return false;
+}
+
+static void
+par_progress_cb(const struct xbps_fetch_cb_data *xfpd)
+{
+	bool last;
+
+	pthread_mutex_lock(&par_mtx);
+	last = par_progress_locked(xfpd);
+	pthread_mutex_unlock(&par_mtx);
+
+	if (last) {
+		/* all packages downloaded: final picture, then close */
+		par_stop_thread();
+		pthread_mutex_lock(&par_mtx);
+		par_redraw(par.xhp, true, true);
+		par_reset();
+		pthread_mutex_unlock(&par_mtx);
+	}
+}
+
+/*
+ * Called from the state callback before anything else is printed:
+ * if a parallel download display is still open (e.g. a transfer
+ * failed, or a package was already cached and never reported an
+ * end), close it so later output doesn't land inside the region
+ * that would otherwise be redrawn.
+ */
+void
+fetch_parallel_finish(struct xbps_handle *xhp)
+{
+	par_stop_thread();
+
+	pthread_mutex_lock(&par_mtx);
+	if (!par.open) {
+		pthread_mutex_unlock(&par_mtx);
+		return;
+	}
+	if (par.fancy && par.drawn > 0) {
+		par_redraw(xhp, true, false);
+		par.drawn = 0;
+	}
+	par_reset();
+	pthread_mutex_unlock(&par_mtx);
+}
