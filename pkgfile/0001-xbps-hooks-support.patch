+/*
+ * Scans every repo *once* and builds a dictionary mapping
+ * "old pkgname that some package's replaces= array names" -> "the
+ * pkgname of the package that replaces it". Used by
+ * xbps_transaction_update_packages() below so that a plain sysupgrade
+ * (-Syu) picks up a rename/replaces-based package swap automatically,
+ * the same way an explicit `xbps-install <newpkg>` already does --
+ * even when the old package is *still* published in the repo pool
+ * (e.g. simply forgotten there rather than pruned), which is why this
+ * doesn't gate on the old package being missing: building the index
+ * once up front and doing an O(1) dictionary lookup per installed
+ * package is cheap enough to always check, unlike the alternative of
+ * rescanning the whole repo pool for every single installed package.
+ */
+static xbps_dictionary_t
+build_replaces_index(struct xbps_handle *xhp)
+{
+	struct build_replaces_index_data d;
+
+	d.index = xbps_dictionary_create();
+	if (d.index == NULL)
+		return NULL;
+	xbps_rpool_foreach(xhp, build_replaces_index_cb, &d);
+	return d.index;
+}
