+/*
+ * Called when a full sysupgrade (-Su/-Syu, or -u with no target
+ * package given) finds that xbps itself -- or whatever package
+ * actually provides it, e.g. a distro's own replacement/fork -- needs
+ * updating before anything else in the transaction can proceed.
+ *
+ * Updates just that one package, then re-execs this same
+ * xbps-install invocation from scratch (same argv) so the freshly
+ * updated binary/library picks up and continues with the rest of the
+ * sysupgrade on its own. This automates the two-phase "update xbps
+ * first, then re-run the same command" workflow a person otherwise
+ * has to do by hand.
+ *
+ * Only one confirmation prompt covers the whole thing: if the person
+ * didn't already pass -y, they're asked once, up front, and -y is
+ * then added to the re-exec'd argv so the continuation after restart
+ * never prompts a second time.
+ */
+static int
+self_update_and_restart(struct xbps_handle *xhp, int argc, char **argv, bool yes)
+{
+	static char yflag[] = "-y";
+	char selfpath[PATH_MAX];
+	char **newargv;
+	ssize_t n;
+	int i, newargc, rv;
+	bool need_y = true;
+
+	if (!yes) {
+		if (!yesno("The package manager needs to update itself before "
+		    "continuing; the rest of this upgrade will then resume "
+		    "automatically, with no further prompts. Continue?")) {
+			return 0;
+		}
+	}
+
+	printf("[*] Updating the package manager first...\n");
+
+	/*
+	 * xbps_transaction_update_packages() above already left xhp->transd
+	 * populated: xbps_autoupdate() -- called from inside it purely to
+	 * *check* whether xbps needs updating -- calls trans_find_pkg()
+	 * itself as a side effect of that check, queuing xbps into the
+	 * transaction even though the caller went on to report EBUSY and
+	 * never actually committed anything. Every transaction-building
+	 * entry point (this one included) assumes it's the first and only
+	 * one to touch xhp->transd in this process, starting from a clean
+	 * slate. Building a second, unrelated transaction on top of that
+	 * already-dirtied one silently produces an inconsistent result
+	 * (previously verified in testing: the update reports success but
+	 * never actually lands on disk, so the process loops forever
+	 * re-detecting EBUSY after each restart). Release it and start
+	 * over clean.
+	 */
+	if (xhp->transd != NULL) {
+		xbps_object_release(xhp->transd);
+		xhp->transd = NULL;
+	}
+
+	rv = xbps_transaction_update_pkg(xhp, "xbps", false);
+	if (rv != 0 && rv != EEXIST) {
+		xbps_error_printf("Failed to queue the package manager update: %s\n",
+		    strerror(rv));
+		return rv;
+	}
+	if (rv == 0) {
+		rv = exec_transaction(xhp, 80, true, false);
+		if (rv != 0) {
+			xbps_error_printf("Failed to update the package manager, aborting.\n");
+			return rv;
+		}
+	}
+
+	/*
+	 * Resolve our own executable's real, current path so the re-exec
+	 * below is guaranteed to load the copy we just updated, rather
+	 * than whatever a PATH lookup on argv[0] might turn up.
+	 */
+	n = readlink("/proc/self/exe", selfpath, sizeof(selfpath) - 1);
+	if (n <= 0) {
+		/* Not on Linux, or /proc unavailable: fall back to argv[0]. */
+		xbps_strlcpy(selfpath, argv[0], sizeof(selfpath));
+	} else {
+		static const char deleted_suffix[] = " (deleted)";
+		size_t suffix_len = sizeof(deleted_suffix) - 1;
+		size_t path_len;
+
+		selfpath[n] = '\0';
+		/*
+		 * We just replaced our own executable file on disk (unlink
+		 * + create a new one at the same path is exactly what a
+		 * package update does, not an in-place edit): the kernel
+		 * appends " (deleted)" to the /proc/self/exe target once
+		 * the *original* inode this process is still running from
+		 * is gone, even though a brand new file now exists at that
+		 * very same path. The path up to that marker is still the
+		 * correct, real location -- strip the marker so we exec
+		 * the file that's actually there now, instead of trying
+		 * (and failing) to exec the literal string with " (deleted)"
+		 * appended.
+		 */
+		path_len = (size_t)n;
+		if (path_len > suffix_len &&
+		    strcmp(selfpath + path_len - suffix_len, deleted_suffix) == 0) {
+			selfpath[path_len - suffix_len] = '\0';
+		}
+	}
+
+	for (i = 0; i < argc; i++) {
+		if (strcmp(argv[i], "-y") == 0 || strcmp(argv[i], "--yes") == 0) {
+			need_y = false;
+			break;
+		}
+	}
+
+	newargv = calloc((size_t)argc + 2, sizeof(char *));
+	if (newargv == NULL) {
+		xbps_error_printf("Out of memory; please re-run the command manually.\n");
+		return ENOMEM;
+	}
+	for (i = 0; i < argc; i++)
+		newargv[i] = argv[i];
+	newargc = argc;
+	if (need_y)
+		newargv[newargc++] = yflag;
+	newargv[newargc] = NULL;
+
+	printf("[*] Package manager updated, resuming the rest of the upgrade...\n");
+	fflush(stdout);
+
+	execv(selfpath, newargv);
+	/* execv() only returns on failure. */
+	xbps_error_printf("Failed to restart %s: %s\n", selfpath, strerror(errno));
+	free(newargv);
+	return errno;
+}
