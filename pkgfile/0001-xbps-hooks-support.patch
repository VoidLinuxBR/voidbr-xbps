+static int
+build_replaces_index_cb(struct xbps_repo *repo, void *arg, bool *done UNUSED)
+{
+	struct build_replaces_index_data *d = arg;
+	xbps_object_iterator_t iter;
+	xbps_object_t obj;
+
+	if (repo->idx == NULL)
