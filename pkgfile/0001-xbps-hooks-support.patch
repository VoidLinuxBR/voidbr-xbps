@@ -108,6 +108,7 @@ xbps_transaction_commit(struct xbps_handle *xhp)
 	xbps_trans_type_t ttype;
 	const char *pkgver = NULL, *pkgname = NULL;
 	int rv = 0;
+	bool pkgdb_unlocked = false;
 
 	setlocale(LC_ALL, "");
 
@@ -208,6 +209,16 @@ xbps_transaction_commit(struct xbps_handle *xhp)
 		goto out;
 	}
 
+	/*
+	 * Run user-defined pre-transaction hooks. A failing pre hook
+	 * aborts the transaction before anything is unpacked/removed.
+	 * Must run after chdir(rootdir) above: xbps_transaction_hooks()
+	 * relies on cwd == rootdir to build a chroot-safe relative exec
+	 * path (same trick xbps_pkg_exec_buffer() uses for pkg scripts).
+	 */
+	if ((rv = xbps_transaction_hooks(xhp, "pre")) != 0)
+		goto out;
+
 	/*
 	 * Run all pre-remove scripts.
 	 * And store the remove scripts in remove_scripts
@@ -394,6 +405,22 @@ xbps_transaction_commit(struct xbps_handle *xhp)
 	if ((rv = xbps_pkgdb_update(xhp, true, true)) != 0)
 		goto out;
 
+	/*
+	 * pkgdb is now flushed to disk. Release the lock here, before
+	 * running any package INSTALL/REMOVE scripts or post-transaction
+	 * hooks: both can legitimately want to shell out to
+	 * xbps-install/xbps-remove themselves (e.g. a hook that clears
+	 * the package cache, or a package script that installs another
+	 * package it needs at runtime), and without releasing the lock
+	 * first, that nested call would deadlock forever waiting on the
+	 * lock this same process is still holding.
+	 *
+	 * The lock is re-acquired further down, right before the final
+	 * pkgdb_update() call, so that write stays protected too.
+	 */
+	xbps_pkgdb_unlock(xhp);
+	pkgdb_unlocked = true;
+
 	/*
 	 * Run all post and purge-remove scripts.
 	 */
@@ -439,10 +466,95 @@ xbps_transaction_commit(struct xbps_handle *xhp)
 		}
 	}
 
+	/*
+	 * Run user-defined post-transaction hooks. Failures here are
+	 * reported but do not change the transaction's own result: the
+	 * install/update/remove already completed successfully by this
+	 * point, and there is nothing left to roll back.
+	 *
+	 * The pkgdb lock was already released above (see the comment
+	 * next to xbps_pkgdb_unlock() near the first xbps_pkgdb_update()
+	 * call), specifically so hooks are free to shell out to
+	 * xbps-install/xbps-remove without deadlocking.
+	 *
+	 * Pre-transaction hooks deliberately do NOT get this treatment:
+	 * at that point nothing has been written yet, so releasing the
+	 * lock there would let a hook-spawned transaction race with (and
+	 * potentially corrupt) the one that's about to run.
+	 */
+	(void)xbps_transaction_hooks(xhp, "post");
+
 out:
 	xbps_object_release(remove_scripts);
 	xbps_object_iterator_release(iter);
 	if (rv == 0) {
+		/*
+		 * Re-acquire the lock released above before this final
+		 * write: pkgdb was safe to read/write-free while post
+		 * and pre-purge scripts and post-transaction hooks ran,
+		 * but this last update needs the same protection the
+		 * first one had. Only do this if we actually unlocked
+		 * earlier in this call -- xbps_pkgdb_lock() is not
+		 * reentrant, and calling it again while this process
+		 * still holds the original lock (every early `goto out`
+		 * above the unlock point) would deadlock the process
+		 * against itself.
+		 */
+		if (pkgdb_unlocked) {
+			xbps_dictionary_t fresh, ours;
+			xbps_array_t pkgs;
+			unsigned int i;
+
+			if (xbps_pkgdb_lock(xhp) < 0)
+				return errno;
+			/*
+			 * While the lock was released, a package script
+			 * or a transaction hook may have spawned its own
+			 * xbps-install/xbps-remove and modified pkgdb on
+			 * disk (e.g. removed some other, unrelated
+			 * package). This process's in-memory xhp->pkgdb
+			 * still reflects the state from right after this
+			 * transaction's own packages were unpacked/
+			 * configured -- it has no idea about that
+			 * external change. Blindly flushing it now would
+			 * silently undo whatever the nested process did
+			 * (a hook removing package X would have X
+			 * resurrected in pkgdb metadata here, even though
+			 * X's files are already gone from disk).
+			 *
+			 * Re-read the current on-disk pkgdb and re-apply
+			 * only *this* transaction's own package state
+			 * changes on top of it, instead of overwriting
+			 * the whole thing with our now-partially-stale
+			 * copy.
+			 */
+			fresh = xbps_dictionary_internalize_from_file(xhp->pkgdb_plist);
+			if (fresh == NULL)
+				fresh = xbps_dictionary_create();
+
+			ours = xhp->pkgdb;
+			pkgs = xbps_dictionary_get(xhp->transd, "packages");
+			for (i = 0; i < xbps_array_count(pkgs); i++) {
+				xbps_dictionary_t pkgd = xbps_array_get(pkgs, i);
+				xbps_trans_type_t pttype = xbps_transaction_pkg_type(pkgd);
+				const char *tpkgname = NULL;
+
+				xbps_dictionary_get_cstring_nocopy(pkgd, "pkgname", &tpkgname);
+				if (tpkgname == NULL)
+					continue;
+
+				if (pttype == XBPS_TRANS_REMOVE) {
+					xbps_dictionary_remove(fresh, tpkgname);
+				} else {
+					xbps_dictionary_t updated =
+					    xbps_dictionary_get(ours, tpkgname);
+					if (updated != NULL)
+						xbps_dictionary_set(fresh, tpkgname, updated);
+				}
+			}
+			xbps_object_release(ours);
+			xhp->pkgdb = fresh;
+		}
 		/* Force a pkgdb write for all unpacked pkgs in transaction */
 		rv = xbps_pkgdb_update(xhp, true, true);
 	}
