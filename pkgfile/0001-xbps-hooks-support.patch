diff --git a/bin/xbps-install/Makefile b/bin/xbps-install/Makefile
index 3526445..201be21 100644
--- a/bin/xbps-install/Makefile
+++ b/bin/xbps-install/Makefile
@@ -3,5 +3,21 @@ TOPDIR = ../..
 
 BIN = xbps-install
 OBJS = main.o transaction.o question.o fetch_cb.o state_cb.o util.o
+OBJS += ../xbps-remove/clean-cache.o
 
 include $(TOPDIR)/mk/prog.mk
+
+# The generic %.o: %.c rule above (from mk/prog.mk) compiles with `-c`
+# and no explicit `-o`, which only produces the right path when the
+# object already exists (built by an earlier, alphabetically-preceding
+# subdirectory) and make skips recompiling it. xbps-remove's own
+# cross-references to ../xbps-install/*.o rely on exactly that
+# ordering accident. Since xbps-install builds *before* xbps-remove
+# alphabetically, the same trick doesn't work in this direction: an
+# explicit rule with a correct -o $@ is needed so the object lands in
+# ../xbps-remove/ instead of here. This must come *after* the
+# mk/prog.mk include, otherwise it becomes the file's first rule and
+# hijacks the default "make" goal away from "all".
+../xbps-remove/clean-cache.o: ../xbps-remove/clean-cache.c
+	@printf " [CC]\t\t$@\n"
+	${SILENT}$(CC) $(CPPFLAGS) $(PROG_CFLAGS) $(CFLAGS) $(EXTRA_CFLAGS) -c $< -o $@
