+
+	iter = xbps_dictionary_iterator(repo->idx);
+	if (iter == NULL)
+		return 0;
+
+	while ((obj = xbps_object_iterator_next(iter))) {
+		xbps_dictionary_t pkgd = xbps_dictionary_get_keysym(repo->idx, obj);
+		xbps_array_t replaces = xbps_dictionary_get(pkgd, "replaces");
+		const char *newpkgname = xbps_dictionary_keysym_cstring_nocopy(obj);
+		unsigned int j;
+
+		if (replaces == NULL || newpkgname == NULL)
+			continue;
+
+		for (j = 0; j < xbps_array_count(replaces); j++) {
+			const char *pattern = NULL;
+			char patname[XBPS_NAME_SIZE] = {0};
+
+			if (!xbps_array_get_cstring_nocopy(replaces, j, &pattern))
+				continue;
+			if (!xbps_pkgpattern_name(patname, sizeof(patname), pattern) &&
+			    !xbps_pkg_name(patname, sizeof(patname), pattern)) {
+				xbps_strlcpy(patname, pattern, sizeof(patname));
+			}
+			/*
+			 * First writer for a given old pkgname wins if two
+			 * different packages both claim to replace it --
+			 * an ambiguous setup, but not this code's job to
+			 * arbitrate; just don't crash or overwrite silently
+			 * back and forth across repos in an unstable order.
+			 */
+			if (!xbps_dictionary_get(d->index, patname))
+				xbps_dictionary_set_cstring(d->index, patname, newpkgname);
+		}
+	}
+	xbps_object_iterator_release(iter);
+	return 0;
+}
